          "_name": "team1",
          "_customHTML": "<section class=\"team1\" group=\"Teams\" plugins=\"amp-main\">\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n    <header>Title</header>\n    <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n    <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\">\n    <select title=\"Align\" name=\"titleAlign\" condition=\"showTitle || showSubtitle\">\n        <option value=\"1\">Left</option>\n        <option value=\"2\" selected>Center</option>\n        <option value=\"3\">Right</option>\n    </select>\n    <header>Cards</header>\n    <input type=\"range\" title=\"Cards Count\" name=\"cardsAmout\" min=\"1\" max=\"8\" value=\"8\" step=\"1\">\n    <input type=\"color\" title=\"Card Overlay\" name=\"cardOverlayColor\" value=\"#ffffff\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\">\n        <input type=\"image\" title=\"Background Image\" value=\"../_images/background4.jpg\">\n        <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type!='color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"bg.type!='color' && overlay\">\n    <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"bg.type!='color' && overlay\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <!--  -->\n    <div mbr-class=\"{'container': !fullWidth,\n                     'container-fluid': fullWidth}\">\n        <div class=\"mbr-row mbr-jc-c mbr-pb-5\" mbr-class=\"{'align-center': titleAlign==2,\n                         'align-right': titleAlign==3}\">\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-12 mbr-pb-4\" mbr-if=\"showTitle\">\n                <h3 class=\"mbr-fonts-style mbr-bold text-upper\" mbr-theme-style=\"display-5\">Our Team</h3>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-12\" mbr-if=\"showSubtitle\">\n                <p class=\"mbr-fonts-style custom-section-subtitle\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-section-subtitle\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Iure consequatur voluptates, rerum explicabo ex recusandae! Magnam odio placeat labore omnis expedita accusamus reiciendis vero asperiores, sed dicta quas pariatur maxime!</p>\n            </div>\n        </div>\n        <div class=\"mbr-row mbr-jc-c\">\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.29.35-506x279.jpg\" layout=\"responsive\" width=\"303.4984372759857\" height=\"167.344\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://intertidal.agency\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.29.35-506x279.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">Intertidal <br>agency</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(US Government Fishery Management)<br>Facilitator / Designer <br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 1\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.30.29-506x279.jpg\" layout=\"responsive\" width=\"303.4984372759857\" height=\"167.344\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://openteam.community\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.30.29-506x279.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">Open Team</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Public Private Partnership)<br>DESIGN Transformation &amp; Facilitation<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 2\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.31.24-506x280.jpg\" layout=\"responsive\" width=\"303.4879571428571\" height=\"167.938\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://cedarcoin.org/about-us\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.31.24-506x280.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">CEDAR COIN <br>UNDP</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Eco-Backed Currency)<br>&nbsp;Solution Architect <br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 3\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.32.13-506x280.jpg\" layout=\"responsive\" width=\"303.4879571428571\" height=\"167.938\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://sepyes.org\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.32.13-506x280.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">Sebastopol entrepreneurs project</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Local Economies)<br>President<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 4\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-16-at-23.10.12-656x341.jpg\" layout=\"responsive\" width=\"303.47214076246337\" height=\"157.75\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://open.spotify.com/user/1215878353\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-16-at-23.10.12-656x341.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">Spotify</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">Tunes 🎵</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 5\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-16-at-23.13.47-656x375.jpg\" layout=\"responsive\" width=\"303.48134400000004\" height=\"173.484\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-16-at-23.13.47-656x375.jpg\" class=\"mbr-temp\" alt title>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">exploros</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Education, Curriculum Delivery)<br>Head of Design<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 6\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-16-at-23.58.18-656x358.jpg\" layout=\"responsive\" width=\"303.49162011173183\" height=\"165.625\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://500px.com/swidnikk\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-16-at-23.58.18-656x358.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">500px&nbsp;📸</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">Captures&nbsp;</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 7\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-17-at-00.01.00-656x371.jpg\" layout=\"responsive\" width=\"303.4945983827493\" height=\"171.641\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-17-at-00.01.00-656x371.jpg\" class=\"mbr-temp\" alt title>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">Young hearts</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Global Volunteerism, Mobile App)<br>Software Architect</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "s8jk4zliry",
          "_anchor": "team1-t",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              ".mbr-overlay": {
                "background-color": "@overlayColor",
                "opacity": "@overlayOpacity"
              }
            },
            ".custom-card": {
              "padding": "1rem"
            },
            ".card-box": {
              "position": "relative",
              "min-width": "250px",
              "max-width": "100%",
              "transition": "0.5s",
              "&:hover": {
                "transform": "translateY(-15px)",
                "box-shadow": "0 25px 45px rgba(0, 0, 0, 0.2)",
                ".overlay": {
                  "top": "0",
                  "opacity": "0.8",
                  "z-index": "999",
                  "@media (max-width: 991px)": {
                    "top": "100%",
                    "opacity": "0"
                  }
                }
              }
            },
            ".overlay": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "flex-direction": "column",
              "opacity": "0",
              "position": "absolute",
              "top": "100%",
              "left": "0",
              "height": "100%",
              "width": "100%",
              "background-color": "@cardOverlayColor",
              "transition": "all 0.5s",
              "pointer-events": "none",
              "& > *": {
                "pointer-events": "all"
              },
              "@media (max-width: 991px)": {
                "top": "0",
                "opacity": "0.8"
              }
            },
            ".person-info": {
              "text-align": "center"
            }
          },
          "_name": "team1",
          "_customHTML": "<section class=\"team1\" group=\"Teams\" plugins=\"amp-main\">\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n    <header>Title</header>\n    <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n    <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\">\n    <select title=\"Align\" name=\"titleAlign\" condition=\"showTitle || showSubtitle\">\n        <option value=\"1\">Left</option>\n        <option value=\"2\" selected>Center</option>\n        <option value=\"3\">Right</option>\n    </select>\n    <header>Cards</header>\n    <input type=\"range\" title=\"Cards Count\" name=\"cardsAmout\" min=\"1\" max=\"8\" value=\"4\" step=\"1\">\n    <input type=\"color\" title=\"Card Overlay\" name=\"cardOverlayColor\" value=\"#ffffff\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\">\n        <input type=\"image\" title=\"Background Image\" value=\"../_images/background4.jpg\">\n        <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type!='color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"bg.type!='color' && overlay\">\n    <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"bg.type!='color' && overlay\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <!--  -->\n    <div mbr-class=\"{'container': !fullWidth,\n                     'container-fluid': fullWidth}\">\n        <div class=\"mbr-row mbr-jc-c mbr-pb-5\" mbr-class=\"{'align-center': titleAlign==2,\n                         'align-right': titleAlign==3}\">\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-12 mbr-pb-4\" mbr-if=\"showTitle\">\n                <h3 class=\"mbr-fonts-style mbr-bold text-upper\" mbr-theme-style=\"display-5\">Our Team</h3>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-12\" mbr-if=\"showSubtitle\">\n                <p class=\"mbr-fonts-style custom-section-subtitle\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-section-subtitle\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Iure consequatur voluptates, rerum explicabo ex recusandae! Magnam odio placeat labore omnis expedita accusamus reiciendis vero asperiores, sed dicta quas pariatur maxime!</p>\n            </div>\n        </div>\n        <div class=\"mbr-row mbr-jc-c\">\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-17-at-16.00.56-506x288.jpg\" layout=\"responsive\" width=\"303.48404166666666\" height=\"172.734\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-17-at-16.00.56-506x288.jpg\" class=\"mbr-temp\" alt title>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">MURAL</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Collaboration &amp; CoCreation)<br>Experts on Demand<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 1\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-17-at-16.16.37-656x373.jpg\" layout=\"responsive\" width=\"303.48705630026814\" height=\"172.562\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-17-at-16.16.37-656x373.jpg\" class=\"mbr-temp\" alt title>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">SEEDS</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Regenerative Finance)<br>Technial Collaboration Designer<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 2\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/credo-656x405.jpg\" layout=\"responsive\" width=\"303.4753185185185\" height=\"187.359\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/credo-656x405.jpg\" class=\"mbr-temp\" alt title>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">CREDO HIGH</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">Teacher,&nbsp;<br>Software Development &amp; <br>Climate Change, First One Planet School in North America<br>(2018-2019)</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 3\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/cf-656x405.jpg\" layout=\"responsive\" width=\"303.4753185185185\" height=\"187.359\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/cf-656x405.jpg\" class=\"mbr-temp\" alt title>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">Climate foundation</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Marine Permaculture)<br>Summer Fellowship Director&nbsp;<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 4\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/face1.jpg\" layout=\"responsive\" width=\"16\" height=\"9\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/face1.jpg\" class=\"mbr-temp\" alt>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">Alan Smith</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">Engineer</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 5\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/face2.jpg\" layout=\"responsive\" width=\"16\" height=\"9\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/face2.jpg\" class=\"mbr-temp\" alt>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">Zoe Smith</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">Designer</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 6\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/face3.jpg\" layout=\"responsive\" width=\"16\" height=\"9\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/face3.jpg\" class=\"mbr-temp\" alt>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">Artour Turk</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">SEO</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 7\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/face4.jpg\" layout=\"responsive\" width=\"16\" height=\"9\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/face4.jpg\" class=\"mbr-temp\" alt>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">Jane Riot</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">SEO</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "s8jk4EKCdu",
          "_anchor": "team1-u",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              ".mbr-overlay": {
                "background-color": "@overlayColor",
                "opacity": "@overlayOpacity"
              }
            },
            "@media (max-width: 768px)": {
              ".title-wrap": {
                "padding-bottom": "2rem"
              }
            },
            ".mbr-jc-b": {
              "justify-content": "space-between"
            },
            ".mbr-jc-sa": {
              "justify-content": "space-around"
            },
            "& when (@showProgressBlock)": {
              ".progress": {
                "height": "100%",
                "border-radius": "0"
              },
              ".progress-wrap": {
                "height": "4px",
                "width": "100%"
              },
              ".progress1": {
                "width": "~\"@{progress1}%\"",
                "background-color": "@progress1Color"
              },
              ".progress2": {
                "width": "~\"@{progress2}%\"",
                "background-color": "@progress2Color"
              },
              ".progress3": {
                "width": "~\"@{progress3}%\"",
                "background-color": "@progress3Color"
              },
              ".progress4": {
                "width": "~\"@{progress4}%\"",
                "background-color": "@progress4Color"
              },
              ".progress5": {
                "width": "~\"@{progress5}%\"",
                "background-color": "@progress5Color"
              },
              ".progress-value1:before": {
                "content": "\"@{progress1}\""
              },
              ".progress-value2:before": {
                "content": "\"@{progress2}\""
              },
              ".progress-value3:before": {
                "content": "\"@{progress3}\""
              },
              ".progress-value4:before": {
                "content": "\"@{progress4}\""
              },
              ".progress-value5:before": {
                "content": "\"@{progress5}\""
              }
            },
            ".tabButton": {
              "max-width": "90px",
              "position": "relative",
              "list-style": "none",
              "flex-grow": "1",
              "text-align": "center",
              "cursor": "pointer"
            },
            ".tabButton::after": {
              "position": "absolute",
              "content": "\"\"",
              "display": "block",
              "border-color": "transparent transparent @tabsColor transparent",
              "border-style": "solid",
              "border-width": "0px 10px 10px",
              "height": "0px",
              "width": "0px",
              "bottom": "-30px",
              "left": "40%",
              "opacity": "0",
              "@media (max-width: 767px)": {
                "display": "none"
              }
            },
            ".tabButton[selected]": {
              "&::after": {
                "opacity": "1"
              },
              "outline": "none",
              ".amp-iconfont, h3": {
                "color": "@tabsColor"
              }
            },
            ".tabContent": {
              "display": "none",
              "width": "100%",
              "margin-top": "30px",
              "padding-top": "20px",
              "order": "1",
              "border-top": "2px solid @tabsColor"
            },
            ".tabButton[selected] + .tabContent": {
              "display": "block"
            },
            ".text-upper": {
              "text-transform": "uppercase"
            },
            ".iconfont-wrapper": {
              "display": "inline-flex"
            },
            ".amp-iconfont": {
              "font-size": "~\"@{iconsSize}rem\"",
              "width": "~\"@{iconsSize}rem\"",
              "color": "@iconsColor",
              "transition": "0.5s"
            },
            "& when (@tabsAmount > 4)": {
              ".iconfont-wrapper": {
                "width": "(@iconsSize - 1rem)",
                "height": "(@iconsSize - 1rem)",
                "@media (max-width: 767px)": {
                  "width": "(@iconsSize - 2rem)",
                  "height": "(@iconsSize - 2rem)"
                }
              },
              ".amp-iconfont": {
                "font-size": "(@iconsSize - 1rem)",
                "width": "(@iconsSize - 1rem)",
                "@media (max-width: 767px)": {
                  "font-size": "(@iconsSize - 2rem)",
                  "width": "(@iconsSize - 2rem)"
                }
              }
            },
            "h3": {
              "transition": "0.5s"
            },
            ".tabButton:hover": {
              ".amp-iconfont, h3": {
                "color": "@tabsColor"
              }
            },
            ".custom-block2-text": {
              "text-align": "center",
              "color": "#616161"
            }
          },
          "_name": "title1",
          "_customHTML": "<section class=\"title1\" group=\"Article\" plugins=\"amp-main, amp-selector\">\n    <mbr-parameters>\n    <!--Block parameters controls (Blue \"Gear\" panel) -->\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"6\">\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n    <input type=\"checkbox\" title=\"Show Progress Block\" name=\"showProgressBlock\">\n    <input type=\"checkbox\" title=\"Show Tabs Block\" name=\"showTabsBlock\" checked>\n    <header>Progress Block</header>\n    <input type=\"checkbox\" title=\"Show Text\" name=\"showProgressText\" checked condition=\"showProgressBlock\">\n    <input type=\"range\" title=\"Progress Count\" name=\"progressAmount\" min=\"1\" max=\"5\" value=\"5\" condition=\"showProgressBlock\">\n    <input type=\"range\" inline title=\"Progress 1\" name=\"progress1\" min=\"0\" max=\"100\" step=\"1\" value=\"71\" condition=\"showProgressBlock\">\n    <input type=\"color\" title=\"Progress 1 Color\" name=\"progress1Color\" value=\"#000000\" condition=\"showProgressBlock\">\n    <!--  -->\n    <input type=\"range\" inline title=\"Progress 2\" name=\"progress2\" min=\"0\" max=\"100\" step=\"1\" value=\"92\" condition=\"progressAmount > 1 &amp;&amp; showProgressBlock\">\n    <input type=\"color\" title=\"Progress 2 Color\" name=\"progress2Color\" value=\"#000000\" condition=\"progressAmount > 1 &amp;&amp; showProgressBlock\">\n    <!--  -->\n    <input type=\"range\" inline title=\"Progress 3\" name=\"progress3\" min=\"0\" max=\"100\" step=\"1\" value=\"65\" condition=\"progressAmount > 2 &amp;&amp; showProgressBlock\">\n    <input type=\"color\" title=\"Progress 3 Color\" name=\"progress3Color\" value=\"#000000\" condition=\"progressAmount > 2 &amp;&amp; showProgressBlock\">\n    <!--  -->\n    <input type=\"range\" inline title=\"Progress 4\" name=\"progress4\" min=\"0\" max=\"100\" step=\"1\" value=\"100\" condition=\"progressAmount > 3 &amp;&amp; showProgressBlock\">\n    <input type=\"color\" title=\"Progress 4 Color\" name=\"progress4Color\" value=\"#000000\" condition=\"progressAmount > 3 &amp;&amp; showProgressBlock\">\n    <!--  -->\n    <input type=\"range\" inline title=\"Progress 5\" name=\"progress5\" min=\"0\" max=\"100\" step=\"1\" value=\"15\" condition=\"progressAmount > 4 &amp;&amp; showProgressBlock\">\n    <input type=\"color\" title=\"Progress 5 Color\" name=\"progress5Color\" value=\"#000000\" condition=\"progressAmount > 4 &amp;&amp; showProgressBlock\">\n    <header>Tabs Block</header>\n    <input type=\"range\" title=\"Tabs Count\" name=\"tabsAmount\" min=\"2\" max=\"6\" value=\"6\" condition=\"showTabsBlock\">\n    <input type=\"range\" title=\"Icons Size\" name=\"iconsSize\" min=\"2.5\" max=\"4\" step=\"0.1\" value=\"4\" condition=\"showTabsBlock\">\n    <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#000000\" condition=\"showTabsBlock\">\n    <input type=\"color\" title=\"Tabs Color\" name=\"tabsColor\" value=\"#cd201f\" condition=\"showTabsBlock\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" required>\n        <input type=\"image\" title=\"Background Image\" value=\"../_images/background2.jpg\">\n        <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay && bg.type == 'image'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <!--Block parameters controls (Blue \"Gear\" panel) -->\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"container\">\n        <div class=\"mbr-row\">\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-2 mbr-pb-2\" mbr-if=\"showTitle\" mbr-class=\"{'mbr-pb-4': !showProgressBlock}\">\n                <h4 class=\"mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\">TRANSFORM</h4>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-5 mbr-pb-4\" mbr-if=\"showProgressBlock\" mbr-class=\"{'mbr-col-lg-10': !showTabsBlock,\n                             'mbr-col-lg-12': !showTabsBlock && !showTitle,\n                             'mbr-col-lg-6': !showTitle}\">\n                <div>\n                    <p class=\"mbr-fonts-style mbr-pb-4 custom-block1-text\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block1-text\" mbr-if=\"showProgressText\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Deleniti molestiae amet, similique rerum quas quod! Animi ab consectetur cum veritatis aut, architecto accusantium aperiam molestias odit beatae amet cupiditate exercitationem autem, recusandae officia nobis magnam doloribus vel cumque dolor necessitatibus!</p>\n                    <div class=\"progress-box mbr-pb-3\">\n\t\t\t\t\t    <div class=\"mbr-flex mbr-jc-b mbr-bold\">\n\t\t\t\t\t\t    <p class=\"mbr-fonts-style mbr-pb-1 prog-title1\" mbr-theme-style=\"display-7\" data-app-selector=\".prog-title1\">Conceptual Design</p>\n\t\t\t\t\t        <span class=\"progress-value1 mbr-fonts-style mbr-bold prog-title1\" mbr-theme-style=\"display-4\" data-app-selector=\".prog-title1\">%</span>\n\t\t\t\t\t    </div>\n                        <div class=\"progress-wrap\">\n                            <div class=\"progress progress1\"></div>\n                        </div>\n                    </div>\n                    <div class=\"progress-box mbr-pb-3\" mbr-if=\"progressAmount > 1\">\n\t\t\t\t\t    <div class=\"mbr-flex mbr-jc-b mbr-bold\">\n\t\t\t\t\t\t    <p class=\"mbr-fonts-style mbr-pb-1 prog-title2\" mbr-theme-style=\"display-7\" data-app-selector=\".prog-title2\">Design</p>\n\t\t\t\t\t        <span class=\"progress-value2 mbr-fonts-style mbr-bold prog-title2\" mbr-theme-style=\"display-4\" data-app-selector=\".prog-title2\">%</span>\n\t\t\t\t\t    </div>\n                        <div class=\"progress-wrap\">\n                            <div class=\"progress progress2\"></div>\n                        </div>\n                    </div>\n                    <div class=\"progress-box mbr-pb-3\" mbr-if=\"progressAmount > 2\">\n\t\t\t\t\t    <div class=\"mbr-flex mbr-jc-b mbr-bold\">\n\t\t\t\t\t\t    <p class=\"mbr-fonts-style mbr-pb-1 prog-title3\" mbr-theme-style=\"display-7\" data-app-selector=\".prog-title3\">Architecture</p>\n\t\t\t\t\t        <span class=\"progress-value3 mbr-fonts-style mbr-bold prog-title3\" mbr-theme-style=\"display-4\" data-app-selector=\".prog-title3\">%</span>\n\t\t\t\t\t    </div>\n                        <div class=\"progress-wrap\">\n                            <div class=\"progress progress3\"></div>\n                        </div>\n                    </div>\n                    <div class=\"progress-box mbr-pb-3\" mbr-if=\"progressAmount > 3\">\n\t\t\t\t\t    <div class=\"mbr-flex mbr-jc-b mbr-bold\">\n\t\t\t\t\t\t    <p class=\"mbr-fonts-style mbr-pb-1 prog-title4\" mbr-theme-style=\"display-7\" data-app-selector=\".prog-title4\">Interior Design</p>\n\t\t\t\t\t        <span class=\"progress-value4 mbr-fonts-style mbr-bold prog-title4\" mbr-theme-style=\"display-4\" data-app-selector=\".prog-title4\">%</span>\n\t\t\t\t\t    </div>\n                        <div class=\"progress-wrap\">\n                            <div class=\"progress progress4\"></div>\n                        </div>\n                    </div>\n                    <div class=\"progress-box\" mbr-if=\"progressAmount > 4\">\n\t\t\t\t\t    <div class=\"mbr-flex mbr-jc-b mbr-bold\">\n\t\t\t\t\t\t    <p class=\"mbr-fonts-style mbr-pb-1 prog-title5\" mbr-theme-style=\"display-7\" data-app-selector=\".prog-title5\">Construction Drawings</p>\n\t\t\t\t\t        <span class=\"progress-value5 mbr-fonts-style mbr-bold prog-title5\" mbr-theme-style=\"display-4\" data-app-selector=\".prog-title5\">%</span>\n\t\t\t\t\t    </div>\n                        <div class=\"progress-wrap\">\n                            <div class=\"progress progress5\"></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-5\" mbr-if=\"showTabsBlock\" mbr-class=\"{'mbr-col-lg-10': !showProgressBlock,\n                             'mbr-col-lg-12': !showProgressBlock && !showTitle,\n                             'mbr-col-lg-6': !showTitle}\">\n                <amp-selector role=\"tablist\" layout=\"container\" class=\"ampTabContainer mbr-flex flex-wrap mbr-jc-sa\">\n                         <!-- TAB -->\n                    <div role=\"tab\" class=\"tabButton\" selected option=\"a\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"amp-iconfont animation-normal mbri-sun\"></span>\n                        </div>\n                        <h3 class=\"mbr-fonts-style mbr-bold text-upper mbr-pt-2 custom-block2-title\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block2-title\">COURAGE</h3>\n                    </div>\n                    <div role=\"tabpanel\" class=\"tabContent\">\n                        <p class=\"mbr-fonts-style custom-block2-text\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block2-text\">\"There are not many people who can think about beautiful things and do common work at the same time. <br>But then there are not many people who have been to the back of the north wind.\" —George MacDonald</p>\n                    </div>\n                         <!-- TAB -->\n                    <div role=\"tab\" class=\"tabButton\" option=\"b\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"amp-iconfont animation-normal mbri-features\"></span>\n                        </div>\n                        <h3 class=\"mbr-fonts-style mbr-bold text-upper mbr-pt-2 custom-block2-title\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block2-title\">INCLUSION</h3>\n                    </div>\n                    <div role=\"tabpanel\" class=\"tabContent\">\n                        <p class=\"mbr-fonts-style custom-block2-text\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block2-text\">\"If you are neutral in situations of injustice, you have chosen the side of the oppressor. If an elephant has its foot on the tail of a mouse and you say that you are neutral, the mouse will not appreciate your neutrality.\" —Desmond TuTu\".</p>\n                    </div>\n                         <!-- TAB -->\n                    <div role=\"tab\" class=\"tabButton\" option=\"c\" mbr-if=\"tabsAmount > 2\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"amp-iconfont animation-normal mbri-rocket\"></span>\n                        </div>\n                        <h3 class=\"mbr-fonts-style mbr-bold text-upper mbr-pt-2 custom-block2-title\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block2-title\">PURPOSE</h3>\n                    </div>\n                    <div role=\"tabpanel\" class=\"tabContent\" mbr-if=\"tabsAmount > 2\">\n                        <p class=\"mbr-fonts-style custom-block2-text\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block2-text\">\"And when heart and head go together, nothing can stand before them.\" —George MacDonald</p>\n                    </div>\n                         <!-- TAB -->\n                    <div role=\"tab\" class=\"tabButton\" option=\"d\" mbr-if=\"tabsAmount > 3\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"amp-iconfont animation-normal mbri-magic-stick\"></span>\n                        </div>\n                        <h3 class=\"mbr-fonts-style mbr-bold text-upper mbr-pt-2 custom-block2-title\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block2-title\">lightness</h3>\n                    </div>\n                    <div role=\"tabpanel\" class=\"tabContent\" mbr-if=\"tabsAmount > 3\">\n                        <p class=\"mbr-fonts-style custom-block2-text\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block2-text\">\"What do you do there, moon, in the sky? Tell me what you do, silent moon. <br>When evening comes you rise and go contemplating wastelands, then you set.\" —Giacomo Leopardi</p>\n                    </div>\n                    <div role=\"tab\" class=\"tabButton\" option=\"e\" mbr-if=\"tabsAmount > 4\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"amp-iconfont animation-normal mbri-speed\"></span>\n                        </div>\n                        <h3 class=\"mbr-fonts-style mbr-bold text-upper mbr-pt-2 custom-block2-title\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block2-title\">Exactitude</h3>\n                    </div>\n                    <div role=\"tabpanel\" class=\"tabContent\" mbr-if=\"tabsAmount > 4\">\n                        <p class=\"mbr-fonts-style custom-block2-text\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block2-text\">\"The greatest forces lie in the region of the uncomprehended.\" —George MacDonald</p>\n                    </div>\n                    <div role=\"tab\" class=\"tabButton\" option=\"f\" mbr-if=\"tabsAmount > 5\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"amp-iconfont animation-normal mbri-protect\"></span>\n                        </div>\n                        <h3 class=\"mbr-fonts-style mbr-bold text-upper mbr-pt-2 custom-block2-title\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block2-title\">trust</h3>\n                    </div>\n                    <div role=\"tabpanel\" class=\"tabContent\" mbr-if=\"tabsAmount > 5\">\n                        <p class=\"mbr-fonts-style custom-block2-text\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-block2-text\">\"Love all, trust a few, do wrong to none.\" —William Shakespear</p>\n                    </div>\n                </amp-selector>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "s8jk4sTzm2",
          "_anchor": "title1-r",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "align-items": "center",
            "display": "flex",
            ".btn": {
              "padding": "5px 50px"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            },
            ".mbr-section-btn, .mbr-text": {
              "color": "#ffffff",
              "text-align": "left"
            }
          },
          "_name": "header1",
          "_customHTML": "<section class=\"header1\" group=\"Headers\" mbr-class=\"{'mbr-fullscreen': fullScreen}\" plugins=\"amp-main\">\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n    <input type=\"checkbox\" name=\"halfSize\" title=\"Half Size\" checked>\n    <select title=\"Align\" name=\"alignHalf\" condition=\"halfSize\">\n        <option value=\"1\" selected>Left</option>\n        <option value=\"2\">Center</option>\n        <option value=\"3\">Right</option>\n    </select>\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n    <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n    <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n    <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n    <select title=\"Align\" name=\"alignTitle\" condition=\"showTitle || showSubtitle || showText || showButtons\">\n        <option value=\"1\" selected>Left</option>\n        <option value=\"2\">Center</option>\n        <option value=\"3\">Right</option>\n    </select>\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" required>\n        <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-01-at-09.04.55-1984x972.jpg\" selected>\n        <input type=\"color\" title=\"Background Color\" value=\"#ffffff\">\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container':!fullWidth,\n                     'container-fluid': fullWidth}\">\n        <div class=\"mbr-row\" mbr-class=\"{'align-left': alignTitle==1,\n                        'align-center': alignTitle==2,\n                        'align-right': alignTitle==3,\n                        'mbr-jc-c':alignHalf==2,\n                        'mbr-jc-e':alignHalf==3}\" mbr-if=\"showTitle || showSubtitle || showText || showButtons\">\n            <div class=\"title-block mbr-col-sm-12 mbr-col-md-12\" mbr-class=\"{'mbr-col-lg-6': halfSize,\n                             'mbr-col-lg-12': !halfSize}\">\n                <h1 class=\"mbr-section-title mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .mbr-section-btn\">Embrace Uncertainty</h1>\n                <h2 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-class=\"{'mbr-pt-3': showTitle}\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle, .mbr-section-btn\">Interior Design Company</h2>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-class=\"{'mbr-pt-2': showTitle || showSubtitle}\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-btn, .mbr-text\"><b>Change direction or you may end up where you are headed. —Lao Tzu</b></p>\n                <div mbr-buttons class=\"mbr-section-btn\" mbr-class=\"{'mbr-pt-4':showSubtitle||showTitle||showText}\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove\" mbr-if=\"showButtons\"><!-- Calendly badge widget begin -->\n<link href=\"https://assets.calendly.com/assets/external/widget.css\" rel=\"stylesheet\" media=\"all\" i-amphtml-timeout=\"1656\">\n[JS_CODE_0]\n                    <a class=\"btn btn-secondary\" onclick=\"Calendly.initPopupWidget({url: 'https://calendly.com/danielswid/hello'});return false;\" data-app-placeholder=\"Type Text\">FESTINA LENTE</a></div>\n                \n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script src=\"https://assets.calendly.com/assets/external/widget.js\" type=\"text/javascript\"></script>"
          ],
          "_cid": "s8jk4LiUTr",
          "_anchor": "header1-w",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              ".mbr-overlay": {
                "background-color": "@overlayColor",
                "opacity": "@overlayOpacity"
              }
            },
            ".link-items": {
              ".fLink": {
                "width": "auto"
              }
            },
            "& when (@typeBlock = '1')": {
              ".mbr-row": {
                "margin": "0",
                "& when (@showCopyright)": {
                  "&:nth-child(1)": {
                    "margin-bottom": "1rem"
                  }
                }
              }
            },
            "& when (@typeBlock = '2')": {
              ".footer-container": {
                "& when (@showCopyright) and (@showItems)": {
                  "@media (min-width: 992px)": {
                    "justify-content": "space-between"
                  },
                  "@media (max-width: 991px)": {
                    "flex-direction": "column",
                    "align-items": "center"
                  }
                }
              },
              ".mbr-row": {
                "width": "auto",
                "@media (max-width: 992px)": {
                  "padding": "0",
                  "width": "100%",
                  "justify-content": "center",
                  "& when (@showCopyright)": {
                    "&:nth-child(1)": {
                      "margin-bottom": "1rem"
                    }
                  }
                }
              },
              ".copyright": {
                "width": "auto"
              }
            },
            ".mbr-text-al-c": {
              "text-align": "center"
            },
            ".iconfont-wrapper": {
              "width": "~\"@{iconsSize}rem\"",
              "height": "~\"@{iconsSize}rem\"",
              "display": "inline-flex",
              "padding": "15px 20px",
              "margin-right": "15px",
              "justify-content": "center",
              "align-items": "center",
              "border-radius": "3px",
              "cursor": "pointer",
              "transition": "0.5s",
              "&:hover .amp-iconfont": {
                "color": "white"
              }
            },
            ".amp-iconfont": {
              "font-size": "~\"@{iconsSize}rem\"",
              "width": "~\"@{iconsSize}rem\"",
              "color": "@primaryColor"
            },
            ".custom-bg-1:hover": {
              "background-color": "@icon1Bg"
            },
            ".custom-bg-2:hover": {
              "background-color": "@icon2Bg"
            },
            ".custom-bg-3:hover": {
              "background-color": "@icon3Bg"
            },
            ".custom-bg-4:hover": {
              "background-color": "@icon4Bg"
            },
            ".custom-bg-5:hover": {
              "background-color": "@icon5Bg"
            },
            ".custom-bg-6:hover": {
              "background-color": "@icon6Bg"
            },
            ".copyleft": {
              "position": "relative",
              "top": "0px",
              "display": "inline-block"
            },
            ".copyleft::after": {
              "content": "\"\\00a9\""
            },
            ".copyright .mbr-text": {
              "color": "#616161"
            }
          },
          "_name": "footer2",
          "_customHTML": "<section class=\"footer2\" group=\"Footers\" plugins=\"amp-main\" global once=\"footer\">\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n    <header>Size</header>\n    <select title=\"Block Type\" name=\"typeBlock\">\n        <option value=\"1\" selected>Type 1</option>\n        <option value=\"2\">Type 2</option>\n    </select>\n    <!--  -->\n    <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\" condition=\"typeBlock==2\">\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n    <!--  -->\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Items\" name=\"showItems\">\n    <input type=\"range\" inline title=\"Items Count\" name=\"itemsCount\" min=\"1\" max=\"7\" step=\"1\" value=\"4\" condition=\"showItems\">\n    <input type=\"checkbox\" title=\"Show Text\" name=\"showText\">\n    <input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked>\n    <header>Icons</header>\n    <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\">\n    <input type=\"range\" title=\"Icons Count\" name=\"iconsAmount\" min=\"1\" max=\"6\" value=\"4\" condition=\"showIcons\">\n    <input type=\"range\" title=\"Icons Size\" name=\"iconsSize\" min=\"1\" max=\"2.5\" step=\"0.1\" value=\"1.3\" condition=\"showIcons\">\n    <input type=\"color\" title=\"Icon 1 BG\" name=\"icon1Bg\" value=\"#55acee\" condition=\"showIcons\">\n    <input type=\"color\" title=\"Icon 2 BG\" name=\"icon2Bg\" value=\"#e4405f\" condition=\"showIcons &amp;&amp; iconsAmount > 1\">\n    <input type=\"color\" title=\"Icon 3 BG\" name=\"icon3Bg\" value=\"#cd201f\" condition=\"showIcons &amp;&amp; iconsAmount > 2\">\n    <input type=\"color\" title=\"Icon 4 BG\" name=\"icon4Bg\" value=\"#3b5999\" condition=\"showIcons &amp;&amp; iconsAmount > 3\">\n    <input type=\"color\" title=\"Icon 5 BG\" name=\"icon5Bg\" value=\"#0088cc\" condition=\"showIcons &amp;&amp; iconsAmount > 4\">\n    <input type=\"color\" title=\"Icon 6 BG\" name=\"icon6Bg\" value=\"#4c75a3\" condition=\"showIcons &amp;&amp; iconsAmount > 5\">\n    <!--  -->\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\">\n        <input type=\"image\" title=\"Background Image\" value=\"../_images/background4.jpg\">\n        <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n    </fieldset>\n    <!--  -->\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type!='color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"bg.type!='color' && overlay\">\n    <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"bg.type!='color' && overlay\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"footer-container\" mbr-class=\"{'container': !fullWidth,\n                     'container-fluid': fullWidth,\n                     'mbr-jc-c': (!showCopyright || !showItems) && typeBlock==2,\n                     'mbr-flex': typeBlock==2,\n                     'mbr-row-reverse': reverseContent}\">\n        <div mbr-list mbr-list-grow=\"itemsCount\" class=\"mbr-row link-items mbr-jc-c mbr-fonts-style\" mbr-if=\"showItems\" mbr-theme-style=\"display-7\">\n            <p class=\"mbr-text fLink mbr-px-1 mbr-bold\" data-app-selector=\".fLink\">Home</p>\n            <p class=\"mbr-text fLink mbr-px-1 mbr-bold\" data-app-selector=\".fLink\">About Us</p>\n            <p class=\"mbr-text fLink mbr-px-1 mbr-bold\" data-app-selector=\".fLink\">Contacts</p>\n            <p class=\"mbr-text fLink mbr-px-1 mbr-bold\" data-app-selector=\".fLink\">FAQ</p>\n            \n        </div>\n        <div class=\"mbr-pt-3 mbr-pb-5 mbr-text-al-c\">\n            <p class=\"mbr-fonts-style mbr-pb-3\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Dolores, cumque.</p>\n            <div class=\"iconfont-wrapper custom-bg-1\" mbr-if=\"showIcons\">\n                <span mbr-icon class=\"amp-iconfont animation-normal fa fa-twitter\"></span>\n            </div>\n            <div class=\"iconfont-wrapper custom-bg-2\" mbr-if=\"showIcons &amp;&amp; iconsAmount > 1\">\n                <span mbr-icon class=\"amp-iconfont animation-normal fa fa-instagram\"></span>\n            </div>\n            <div class=\"iconfont-wrapper custom-bg-3\" mbr-if=\"showIcons &amp;&amp; iconsAmount > 2\">\n                <span mbr-icon class=\"amp-iconfont animation-normal fa fa-youtube\"></span>\n            </div>\n            <div class=\"iconfont-wrapper custom-bg-4\" mbr-if=\"showIcons &amp;&amp; iconsAmount > 3\">\n                <span mbr-icon class=\"amp-iconfont animation-normal fa fa-facebook\"></span>\n            </div>\n            <div class=\"iconfont-wrapper custom-bg-1\" mbr-if=\"showIcons &amp;&amp; iconsAmount > 4\">\n                <span mbr-icon class=\"amp-iconfont animation-normal fa fa-twitter\"></span>\n            </div>\n            <div class=\"iconfont-wrapper custom-bg-2\" mbr-if=\"showIcons &amp;&amp; iconsAmount > 5\">\n                <span mbr-icon class=\"amp-iconfont animation-normal fa fa-instagram\"></span>\n            </div>\n        </div>\n        <div class=\"align-center\" style=\"height: 25px;\">\n            <img src=\"@PROJECT_PATH@/assets/images/sendak-monsters-concept-2-2-40x40.png\" style=\"width:auto; max-height:100%;\" alt title>\n        </div>\n        <div class=\"copyright mbr-px-2 mbr-flex mbr-jc-c\" mbr-if=\"showCopyright\">\n            <p class=\"mbr-text mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".copyright .mbr-text\" data-app-placeholder=\"Type Text\"><i><br>Reach for the stars of tomorrow with the possible of today.<br></i>Copyright&nbsp;<span class=\"copyleft\"></span> Bedtime for Big Monsters<br><br></p>\n        </div>\n         <div class=\"align-center\" style=\"height: 80px;\">\n            <a href=\"https://www.thegreenwebfoundation.org/green-web-check/?url=bedtimeforbigmonsters.com\" target=\"_blank\"><img src=\"https://api.thegreenwebfoundation.org/greencheckimage/bedtimeforbigmonsters.com\" alt=\"This website is hosted Green - checked by thegreenwebfoundation.org\" style=\"width:auto; max-height:100%;\"></a>\n        </div>\n       \n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "s8jk4MAwxu",
          "_anchor": "footer2-x",
          "_protectedParams": [],
          "_global": true,
          "_once": "footer",
          "_params": {}
        }
      ]
    },
    "offerings.html": {
      "settings": {
        "title": "Offerings | Bedtime for Big Monsters",
        "order": 1
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              ".mbr-overlay": {
                "background-color": "@overlayColor",
                "opacity": "@overlayOpacity"
              }
            },
            "amp-img,img": {
              "height": "auto",
              "width": "100%"
            },
            ".gallery-row": {
              "& when not (@flexDirection)": {
                "padding-left": "0",
                "padding-right": "0"
              },
              "@media (max-width: 992px)": {
                "justify-content": "center"
              }
            },
            ".gallery-item": {
              "& when (@flexDirection)": {
                "padding-left": "0",
                "padding-right": "0"
              }
            },
            ".gallery-row, .gallery-item": {
              "padding-left": "0.5rem",
              "padding-right": "0.5rem",
              "@media (max-width: 768px)": {
                "padding-left": "0rem",
                "padding-right": "0rem"
              }
            },
            ".gallery-item, .gallery-row": {
              "&:nth-last-child(1)": {
                "padding-bottom": "0"
              }
            },
            "& when not (@paddingCard)": {
              ".gallery-item, .gallery-row": {
                "padding": "0!important"
              }
            },
            ".gallery-img-wrap": {
              "position": "relative",
              "& when (@captionHover)": {
                "&:hover": {
                  ".overlay-caption": {
                    "right": "0",
                    "opacity": "@imgOverlayOpacity"
                  }
                }
              },
              "& when not (@captionHover)": {
                "&:hover": {
                  ".overlay-caption": {
                    "right": "-100%",
                    "opacity": "0"
                  }
                }
              },
              "&::after": {
                "background": "none"
              }
            },
            ".overlay-caption": {
              "align-items": "center",
              "flex-direction": "column",
              "padding": "20px 10px 30px 30px",
              "opacity": "0",
              "position": "absolute",
              "bottom": "0",
              "right": "-100%",
              "left": "auto",
              "max-height": "100%",
              "width": "80%",
              "background-color": "@imgOverlayColor",
              "border-left": "2px solid @borderColor",
              "transition": "1s",
              "& when not (@captionHover)": {
                "right": "0",
                "opacity": "1"
              }
            },
            "& when not (@fullWidth)": {
              ".overlay-caption": {
                "padding": "10px"
              }
            },
            ".mbr-row": {
              "padding-left": "0rem",
              "padding-right": "0rem",
              "@media (max-width: 767px)": {
                "padding-left": "1rem",
                "padding-right": "1rem"
              }
            },
            "h4": {
              "width": "100%",
              "padding-right": "8px",
              "padding-left": "8px"
            },
            "@media (max-width: 991px)": {
              ".overlay-caption": {
                "opacity": "1",
                "right": "0"
              },
              ".gallery-img-wrap": {
                "& when (@captionHover)": {
                  "&:hover": {
                    ".overlay-caption": {
                      "right": "-100%",
                      "opacity": "0"
                    }
                  }
                }
              }
            }
          },
          "_name": "gallery1",
          "_sourceTheme": "simpleamp",
          "_customHTML": "<section class=\"gallery1\" group=\"Gallery & Slider\" plugins=\"amp-main, amp-image-lightbox\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" title=\"Row/Column\" name=\"flexDirection\">\n\n        <header>Title</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\">\n        <select title=\"Align\" name=\"titleAlign\" condition=\"showTitle || showSubtitle\">\n            <option value=\"1\">Left</option>\n            <option value=\"2\" selected>Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <header>Card</header>\n        <input type=\"range\" inline title=\"Containers Count\" name=\"containersCount\" min=\"1\" max=\"4\" step=\"1\" value=\"2\" required>\n        <input type=\"range\" inline title=\"1st Container Items\" name=\"firstCount\" min=\"1\" max=\"4\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"2nd Container Items\" name=\"secondCount\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"containersCount > 1\">\n        <input type=\"range\" inline title=\"3rd Container Items\" name=\"thirdCount\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"containersCount > 2\">\n        <input type=\"range\" inline title=\"4th Container Items\" name=\"fourthCount\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"containersCount > 3\">\n        <input type=\"checkbox\" title=\"Padding Card\" name=\"paddingCard\" checked>\n        <input type=\"range\" inline title=\"Image Overlay Opacity\" name=\"imgOverlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\">\n        <header>Caption</header>\n        <input type=\"checkbox\" title=\"Show Caption\" name=\"showCaption\" checked required>\n        <input type=\"checkbox\" title=\"Change Hover Effect\" name=\"captionHover\" condition=\"showCaption\" checked>\n        <input type=\"color\" title=\"Background Color\" name=\"imgOverlayColor\" value=\"#ffffff\" condition=\"showCaption\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#000000\" condition=\"showCaption\">\n        <select title=\"Align\" name=\"captionAlign\" condition=\"showCaption\">\n            <option value=\"1\">Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\" selected>Right</option>\n        </select>\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n        </fieldset>\n        <!--  -->\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth,\n        'container-fluid': fullWidth}\">\n        <div class=\"mbr-row mbr-jc-c mbr-pb-4\" mbr-class=\"{'align-center': titleAlign==2,\n                         'align-right': titleAlign==3}\">\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-12 mbr-pb-2\" mbr-if=\"showTitle\">\n                <h3 class=\"mbr-fonts-style mbr-bold text-upper\" mbr-theme-style=\"display-5\">Our Works</h3>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-12\" mbr-if=\"showSubtitle\">\n                <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Iure consequatur voluptates, rerum explicabo ex recusandae! Magnam odio placeat labore omnis expedita accusamus reiciendis vero asperiores, sed dicta quas pariatur maxime!</p>\n            </div>\n        </div>\n        <div class=\"mbr-row gallery-wrap mbr-jc-c\">\n            <div class=\"mbr-col-md-12 mbr-col-sm-12 gallery-row row-first flex-wrap\" mbr-class=\"{'mbr-col-lg-3':containersCount==4 && flexDirection,\n                            'mbr-col-lg-4':containersCount==3 && flexDirection,\n                            'mbr-col-lg-6':containersCount==2 && flexDirection,\n                            'mbr-col-lg-12':containersCount==1 && flexDirection,\n                            'mbr-col-lg-12 mbr-pb-2 mbr-flex':!flexDirection,\n                            'md-pb':flexDirection}\" mbr-list mbr-list-grow=\"firstCount\">\n                <div class=\"gallery-item mbr-col-sm-12\" mbr-class=\"{'mbr-col-lg-3':firstCount==4 && !flexDirection,\n                                'mbr-col-lg-4':firstCount==3 && !flexDirection,\n                                'mbr-col-lg-6':firstCount==2 && !flexDirection,\n                                'mbr-col-lg-12':(firstCount==1 && !flexDirection) || flexDirection,\n                                'mbr-col-md-12 mbr-pb-4':flexDirection,\n                                'mbr-col-md-8 md-pb mbr-px-2':!flexDirection}\">\n                    <div class=\"gallery-img-wrap\">\n                        <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" layout=\"responsive\" height=\"255\" width=\"378.65429234338745\" alt=\"image\" on=\"tap:lightbox1\" role=\"button\" tabindex=\"0\">\n                            <div placeholder class=\"placeholder\"></div>\n                            <img class=\"mbr-temp\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" alt>\n                        </amp-img>\n                        <div class=\"overlay-caption mbr-flex mbr-jc-c\" mbr-class=\"{'align-center': captionAlign == 2,\n                                         'align-right': captionAlign == 3}\" mbr-if=\"showCaption\">\n                             <h4 class=\"mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\">Story Mapping</h4>\n                            <p class=\"caption-text mbr-fonts-style mbr-p-1 mbr-black\" mbr-theme-style=\"display-7\" data-app-selector=\".caption-text\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptas, qui!</p>\n                        </div>\n                    </div>\n                </div>\n            <div class=\"gallery-item mbr-col-sm-12\" mbr-class=\"{'mbr-col-lg-3':firstCount==4 && !flexDirection,\n                                'mbr-col-lg-4':firstCount==3 && !flexDirection,\n                                'mbr-col-lg-6':firstCount==2 && !flexDirection,\n                                'mbr-col-lg-12':(firstCount==1 && !flexDirection) || flexDirection,\n                                'mbr-col-md-12 mbr-pb-4':flexDirection,\n                                'mbr-col-md-8 md-pb mbr-px-2':!flexDirection}\">\n                    <div class=\"gallery-img-wrap\">\n                        <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" layout=\"responsive\" height=\"255\" width=\"378.65429234338745\" alt=\"image\" on=\"tap:lightbox1\" role=\"button\" tabindex=\"0\">\n                            <div placeholder class=\"placeholder\"></div>\n                            <img class=\"mbr-temp\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" alt>\n                        </amp-img>\n                        <div class=\"overlay-caption mbr-flex mbr-jc-c\" mbr-class=\"{'align-center': captionAlign == 2,\n                                         'align-right': captionAlign == 3}\" mbr-if=\"showCaption\">\n                             <h4 class=\"mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\">Project</h4>\n                            <p class=\"caption-text mbr-fonts-style mbr-p-1 mbr-black\" mbr-theme-style=\"display-7\" data-app-selector=\".caption-text\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptas, qui!</p>\n                        </div>\n                    </div>\n                </div><div class=\"gallery-item mbr-col-sm-12\" mbr-class=\"{'mbr-col-lg-3':firstCount==4 && !flexDirection,\n                                'mbr-col-lg-4':firstCount==3 && !flexDirection,\n                                'mbr-col-lg-6':firstCount==2 && !flexDirection,\n                                'mbr-col-lg-12':(firstCount==1 && !flexDirection) || flexDirection,\n                                'mbr-col-md-12 mbr-pb-4':flexDirection,\n                                'mbr-col-md-8 md-pb mbr-px-2':!flexDirection}\">\n                    <div class=\"gallery-img-wrap\">\n                        <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" layout=\"responsive\" height=\"255\" width=\"378.65429234338745\" alt=\"image\" on=\"tap:lightbox1\" role=\"button\" tabindex=\"0\">\n                            <div placeholder class=\"placeholder\"></div>\n                            <img class=\"mbr-temp\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" alt>\n                        </amp-img>\n                        <div class=\"overlay-caption mbr-flex mbr-jc-c\" mbr-class=\"{'align-center': captionAlign == 2,\n                                         'align-right': captionAlign == 3}\" mbr-if=\"showCaption\">\n                             <h4 class=\"mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-5\">Project</h4>\n                            <p class=\"caption-text mbr-fonts-style mbr-p-1 mbr-black\" mbr-theme-style=\"display-7\" data-app-selector=\".caption-text\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptas, qui!</p>\n                        </div>\n                    </div>\n                </div></div>\n            <div class=\"mbr-col-md-12 mbr-col-sm-12 gallery-row row-second flex-wrap\" mbr-class=\"{'mbr-col-lg-3':containersCount==4 && flexDirection,\n                            'mbr-col-lg-4':containersCount==3 && flexDirection,\n                            'mbr-col-lg-6':containersCount==2 && flexDirection,\n                            'mbr-col-lg-12 mbr-pb-4 mbr-flex': !flexDirection,\n                            'md-pb':flexDirection}\" mbr-if=\"containersCount>1\" mbr-list=\"\" mbr-list-grow=\"secondCount\">\n                <div class=\"gallery-item mbr-col-sm-12\" mbr-class=\"{'mbr-col-lg-3':secondCount==4 && !flexDirection,\n                                'mbr-col-lg-4':secondCount==3 && !flexDirection,\n                                'mbr-col-lg-6':secondCount==2 && !flexDirection,\n                                'mbr-col-lg-12':(secondCount==1 && !flexDirection) || flexDirection,\n                                'mbr-col-md-12 mbr-pb-4':flexDirection,\n                                'mbr-col-md-8 md-pb mbr-px-2':!flexDirection}\">\n                    <div class=\"gallery-img-wrap\">\n                        <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" layout=\"responsive\" height=\"255\" width=\"378.65429234338745\" alt=\"image\" on=\"tap:lightbox1\" role=\"button\" tabindex=\"0\">\n                            <div placeholder class=\"placeholder\"></div>\n                            <img class=\"mbr-temp\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" alt>\n                        </amp-img>\n                        <div class=\"overlay-caption mbr-fl
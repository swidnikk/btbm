          "_name": "content8",
          "_customHTML": "<section class=\"mbr-section content8\" group=\"Features\" plugins=\"amp-main\">\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n            <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n            <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n            <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <!-- -->\n        <header>Title</header>\n            <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n            <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <header>Icons</header>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\" checked>\n        <input type=\"range\" title=\"Icons Size\" name=\"iconsSize\" min=\"2\" max=\"4\" step=\"0.1\" value=\"4\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#cd201f\" condition=\"showIcons\">\n        <header>Background</header>\n            <fieldset type=\"background\" name=\"bg\" required>\n                <input type=\"color\" title=\"Background Color\" value=\"#f6f9f8\" selected>\n                <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n            </fieldset>\n            <!--  -->\n            <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n            <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay && bg.type == 'image'\">\n            <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type == 'image'\">\n    <!-- End block parameters -->\n    </mbr-parameters> \n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container':!fullWidth,\n                     'container-fluid':fullWidth}\">\n        <div class=\"mbr-row\">\n            <div class=\"mbr-col-sm-12 mbr-col-md-4 mbr-col-lg-4\">\n                <div class=\"card-box mbr-flex\">\n                    <div class=\"icon-box mbr-pb-1\" mbr-if=\"showIcons\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"amp-iconfont animation-normal fa-paint-brush fa\"></span>\n                        </div>\n                    </div>\n                    <div class=\"text-box\">\n                        <h3 class=\"mbr-fonts-style mbr-pb-1 mbr-bold custom-card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".custom-card-title\">Cooperation</h3>\n                        <p class=\"mbr-fonts-style custom-card-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".custom-card-subtitle\">EASY</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-4 mbr-col-lg-4\">\n                <div class=\"card-box mbr-flex\">\n                    <div class=\"icon-box mbr-pb-1\" mbr-if=\"showIcons\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"amp-iconfont animation-normal fa-clock-o fa\"></span>\n                        </div>\n                    </div>\n                    <div class=\"text-box\">\n                        <h3 class=\"mbr-fonts-style mbr-pb-1 mbr-bold custom-card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".custom-card-title\">Collaboration</h3>\n                        <p class=\"mbr-fonts-style custom-card-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".custom-card-subtitle\">CHALLENGE</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-4 mbr-col-lg-4\">\n                <div class=\"card-box mbr-flex\">\n                    <div class=\"icon-box mbr-pb-1\" mbr-if=\"showIcons\">\n                        <div class=\"iconfont-wrapper\">\n                            <span mbr-icon class=\"amp-iconfont animation-normal fa-rocket fa\"></span>\n                        </div>\n                    </div>\n                    <div class=\"text-box\">\n                        <h3 class=\"mbr-fonts-style mbr-pb-1 mbr-bold custom-card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".custom-card-title\">Co-Creation</h3>\n                        <p class=\"mbr-fonts-style custom-card-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".custom-card-subtitle\">HARD</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",

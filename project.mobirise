dsLinks\" data-app-selector=\".custom-link\">\n                                <a href=\"#\" class=\"text-black\">Read More</a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-4\" mbr-class=\"{'mbr-col-lg-12': !flexDirection}\" mbr-if=\"cardsCount > 3\">\n                <div class=\"card-box-wrapper\">\n                    <div class=\"card-box\" mbr-class=\"{'align-center': cardsAlign==2,\n                                     'align-right': cardsAlign==3}\">\n                        <div class=\"img-box\">\n                            <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" layout=\"responsive\" height=\"9\" width=\"16\" alt=\"image\">\n                                <div placeholder=\"\" class=\"placeholder\"></div>\n                                <img class=\"mbr-temp\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" alt=\"\">\n                            </amp-img>\n                        </div>\n                        <div class=\"text-box\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcons\">\n                                <span mbr-icon=\"\" class=\"amp-iconfont animation-normal mbri-success\"></span>\n                            </div>\n                            <h4 class=\"mbr-fonts-style mbr-bold mbr-pb-2 custom-card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardsTitle\" data-app-selector=\".custom-card-title\">Title</h4>\n                            <p class=\"mbr-fonts-style mbr-pb-2 custom-card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsText\" data-app-selector=\".custom-card-text\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Optio alias repellendus architecto. Soluta neque officia hic corrupti sapiente inventore autem.</p>\n                            <div class=\"custom-link link mbr-fonts-style mbr-bold mbr-black\" mbr-text=\"\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsLinks\" data-app-selector=\".custom-link\">\n                                <a href=\"#\" class=\"text-black\">Read More</a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-4\" mbr-class=\"{'mbr-col-lg-12': !flexDirection}\" mbr-if=\"cardsCount > 4\">\n                <div class=\"card-box-wrapper\">\n                    <div class=\"card-box\" mbr-class=\"{'align-center': cardsAlign==2,\n                                     'align-right': cardsAlign==3}\">\n                        <div class=\"img-box\">\n                            <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" layout=\"responsive\" height=\"9\" width=\"16\" alt=\"image\">\n                                <div placeholder=\"\" class=\"placeholder\"></div>\n                                <img class=\"mbr-temp\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" alt=\"\">\n                            </amp-img>\n                        </div>\n                        <div class=\"text-box\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcons\">\n                                <span mbr-icon=\"\" class=\"amp-iconfont animation-normal mbri-success\"></span>\n                            </div>\n                            <h4 class=\"mbr-fonts-style mbr-bold mbr-pb-2 custom-card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardsTitle\" data-app-selector=\".custom-card-title\">Title</h4>\n                            <p class=\"mbr-fonts-style mbr-pb-2 custom-card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsText\" data-app-selector=\".custom-card-text\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Optio alias repellendus architecto. Soluta neque officia hic corrupti sapiente inventore autem.</p>\n                            <div class=\"custom-link link mbr-fonts-style mbr-bold mbr-black\" mbr-text=\"\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsLinks\" data-app-selector=\".custom-link\">\n                                <a href=\"#\" class=\"text-black\">Read More</a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-4\" mbr-class=\"{'mbr-col-lg-12': !flexDirection}\" mbr-if=\"cardsCount > 5\">\n                <div class=\"card-box-wrapper\">\n                    <div class=\"card-box\" mbr-class=\"{'align-center': cardsAlign==2,\n                                     'align-right': cardsAlign==3}\">\n                        <div class=\"img-box\">\n                            <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" layout=\"responsive\" height=\"9\" width=\"16\" alt=\"image\">\n                                <div placeholder=\"\" class=\"placeholder\"></div>\n                                <img class=\"mbr-temp\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" alt=\"\">\n                            </amp-img>\n                        </div>\n                        <div class=\"text-box\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcons\">\n                                <span mbr-icon=\"\" class=\"amp-iconfont animation-normal mbri-success\"></span>\n                            </div>\n                            <h4 class=\"mbr-fonts-style mbr-bold mbr-pb-2 custom-card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardsTitle\" data-app-selector=\".custom-card-title\">Title</h4>\n                            <p class=\"mbr-fonts-style mbr-pb-2 custom-card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsText\" data-app-selector=\".custom-card-text\">Lorem ipsum dolor sit amet consectetur adipisicing elit. Optio alias repellendus architecto. Soluta neque officia hic corrupti sapiente inventore autem.</p>\n                            <div class=\"custom-link link mbr-fonts-style mbr-bold mbr-black\" mbr-text=\"\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsLinks\" data-app-selector=\".custom-link\">\n                                <a href=\"#\" class=\"text-black\">Read More</a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "ss9fIXVgVq",
          "_anchor": "features6-19",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              ".mbr-overlay": {
                "background-color": "@overlayColor",
                "opacity": "@overlayOpacity"
              }
            },
            ".card-box": {
              "width": "100%",
              "background-color": "@cardBg",
              "transition": "0.5s",
              "&:hover": {
                "transform": "translateY(-15px)",
                "box-shadow": "0 25px 45px rgba(0, 0, 0, 0.2)",
                ".iconfont-wrapper": {
                  "transform": "rotateZ(360deg)"
                }
              }
            },
            ".card-box-wrapper": {
              "margin-bottom": "2rem"
            },
            ".text-box": {
              "padding": "70px 50px",
              "@media (max-width: 767px)": {
                "padding": "50px 30px"
              }
            },
            ".text-upper": {
              "text-transform": "uppercase"
            },
            ".img-box": {
              "position": "relative"
            },
            ".date-box": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "padding": "30px 20px",
              "background-color": "@dateBg",
              "border-right": "2px solid @dateBorder",
              "z-index": "999"
            },
            ".iconfont-wrapper": {
              "width": "~\"@{iconsSize}rem\"",
              "height": "~\"@{iconsSize}rem\"",
              "display": "inline-flex",
              "justify-content": "center",
              "align-items": "center",
              "margin-right": "10px"
            },
            ".amp-iconfont": {
              "font-size": "~\"@{iconsSize}rem\"",
              "width": "~\"@{iconsSize}rem\"",
              "color": "@primaryColor"
            },
            ".tag-text": {
              "display": "inline",
              "margin-right": "25px"
            },
            ".mbr-ai-c": {
              "align-items": "center"
            }
          },
          "_name": "features7",
          "_sourceTheme": "simpleamp",
          "_customHTML": "<section class=\"features7\" group=\"Article\" plugins=\"amp-main\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Row/Column\" name=\"flexDirection\" checked=\"\">\n        <header>Title</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked=\"\">\n        <select title=\"Align\" name=\"titleAlign\" condition=\"showTitle || showSubtitle\">\n            <option value=\"1\">Left</option>\n            <option value=\"2\" selected=\"\">Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <header>Cards</header>\n        <input type=\"range\" inline=\"\" title=\"Cards Count\" name=\"cardsCount\" min=\"1\" max=\"6\" step=\"1\" value=\"2\" required=\"\">\n        <select title=\"Align\" name=\"cardsAlign\">\n            <option value=\"1\" selected=\"\">Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showCardsTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\" checked=\"\">\n        <input type=\"range\" title=\"Icons Count\" name=\"iconsAmount\" min=\"1\" max=\"2\" value=\"2\" condition=\"showIcons\">\n        <input type=\"range\" title=\"Icons Size\" name=\"iconsSize\" min=\"1\" max=\"2\" step=\"0.1\" value=\"1\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showCardsText\" checked=\"\">\n        <input type=\"color\" title=\"Color\" name=\"cardBg\" value=\"#ffffff\">\n        <hr>\n        <input type=\"checkbox\" title=\"Show Date Box\" name=\"showDate\" checked=\"\">\n        <input type=\"color\" title=\"Border Color\" name=\"dateBorder\" value=\"#000000\">\n        <input type=\"color\" title=\"Background\" name=\"dateBg\" value=\"#ffffff\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required=\"\">\n            <input type=\"color\" title=\"Background Color\" value=\"#f6f9f8\" selected=\"\">\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background3.jpg\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked=\"\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container':!fullWidth,\n                     'container-fluid':fullWidth}\">\n        <div class=\"mbr-row mbr-jc-c mbr-pb-5\" mbr-class=\"{'align-center': titleAlign==2,\n                         'align-right': titleAlign==3}\">\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-12 mbr-pb-4\" mbr-if=\"showTitle\">\n                <h3 class=\"mbr-fonts-style mbr-bold line-title\" mbr-theme-style=\"display-5\">Our News</h3>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-12\" mbr-if=\"showSubtitle\">\n                <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">Lorem ipsum dolor sit amet consectetur\n                    adipisicing elit. Iure consequatur voluptates, rerum explicabo ex recusandae!</p>\n            </div>\n        </div>\n        <div class=\"mbr-row mbr-jc-c mbr-ai-c\" mbr-class=\"{'mbr-column': !flexDirection}\">\n            <div class=\"mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-6\" mbr-class=\"{'mbr-col-lg-10': cardsCount == 1 || !flexDirection}\">\n                <div class=\"card-box-wrapper\">\n                    <div class=\"card-box\" mbr-class=\"{'align-center': cardsAlign==2,\n                                     'align-right': cardsAlign==3}\">\n                        <div class=\"img-box\">\n                            <div class=\"date-box\" mbr-if=\"showDate\">\n                                <p class=\"mbr-fonts-style mbr-bold custom-card-date\" mbr-theme-style=\"display-2\" data-app-selector=\".custom-card-date\">18</p>\n                                <p class=\"mbr-fonts-style mbr-bold text-upper custom-card-date\" mbr-theme-style=\"display-4\" data-app-selector=\".custom-card-date\">January 2025</p>\n                            </div>\n                            <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" layout=\"responsive\" height=\"362.297\" width=\"537.9816241299304\" alt=\"image\">\n                                <div placeholder=\"\" class=\"placeholder\"></div>\n                                <img class=\"mbr-temp\" src=\"@PROJECT_PATH@/assets/images/background1.jpg\" alt=\"\">\n                            </amp-img>\n                        </div>\n                        <div class=\"text-box\">\n                            <h4 class=\"mbr-fonts-style mbr-bold mbr-pb-2 custom-card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardsTitle\" data-app-selector=\".custom-card-title\">Interior Ideas of 2025</h4>\n                            <div mbr-if=\"showIcons\">\n                                <div class=\"iconfont-wrapper\">\n                                    <span mbr-icon=\"\" class=\"amp-iconfont animation-normal fa fa-mortar-board\"></span>\n                                </div>\n                                <p class=\"mbr-fonts-style tag-text\" mbr-theme-style=\"display-4\">Lorem</p>\n                                <div class=\"iconfont-wrapper\" mbr-if=\"iconsAmount > 1\">\n                                    <span mbr-icon=\"\" class=\"amp-iconfont animation-normal fa fa-user\"></span>\n                                </div>\n                                <p class=\"mbr-fonts-style tag-text\" mbr-theme-style=\"display-4\" mbr-if=\"iconsAmount > 1\">Lorem</p>\n                            </div>\n                            <p class=\"mbr-fonts-style mbr-pt-2 custom-card-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsText\" data-app-selector=\".custom-card-text\">Lorem\n                                ipsum dolor sit amet consectetur adipisicing elit. Optio alias repellendus architecto.\n                                Soluta neque officia hic corrupti sapiente inventore autem.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-6\" mbr-class=\"{'mbr-col-lg-10': !flexDirection}\" mbr-if=\"cardsCount > 1\">\n                <div class=\"card-box-wrapper\">\n                    <div class=\"card-box\" mbr-class=\"{'align-center': cardsAlign==2,\n                                     'align-right': cardsAlign==3}\">\n                        <div class=\"img-box\">\n                            <div class=\"date-box\" mbr-if=\"showDate\">\n                                <p class=\"mbr-fonts-style mbr-bold custom-card-date\" mbr-theme-style=\"display-2\" data-app-selector=\".custom-card-date\">20</p>\n                                <p class=\"mbr-fonts-style mbr-bold text-upper custom-card-date\" mbr-theme-style=\"display-4\" data-app-selector=\".custom-card-date\">January 2025</p>\n                            </div>\n                           
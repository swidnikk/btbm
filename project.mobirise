        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              ".mbr-overlay": {
                "background-color": "@overlayColor",
                "opacity": "@overlayOpacity"
              }
            },
            ".custom-card": {
              "padding": "1rem"
            },
            ".card-box": {
              "position": "relative",
              "min-width": "250px",
              "max-width": "100%",
              "transition": "0.5s",
              "&:hover": {
                "transform": "translateY(-15px)",
                "box-shadow": "0 25px 45px rgba(0, 0, 0, 0.2)",
                ".overlay": {
                  "top": "0",
                  "opacity": "0.8",
                  "z-index": "999",
                  "@media (max-width: 991px)": {
                    "top": "100%",
                    "opacity": "0"
                  }
                }
              }
            },
            ".overlay": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "flex-direction": "column",
              "opacity": "0",
              "position": "absolute",
              "top": "100%",
              "left": "0",
              "height": "100%",
              "width": "100%",
              "background-color": "@cardOverlayColor",
              "transition": "all 0.5s",
              "pointer-events": "none",
              "& > *": {

          "_name": "team1",
          "_customHTML": "<section class=\"team1\" group=\"Teams\" plugins=\"amp-main\">\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n    <header>Title</header>\n    <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n    <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n    <select title=\"Align\" name=\"titleAlign\" condition=\"showTitle || showSubtitle\">\n        <option value=\"1\">Left</option>\n        <option value=\"2\" selected>Center</option>\n        <option value=\"3\">Right</option>\n    </select>\n    <header>Cards</header>\n    <input type=\"range\" title=\"Cards Count\" name=\"cardsAmout\" min=\"1\" max=\"8\" value=\"8\" step=\"1\">\n    <input type=\"color\" title=\"Card Overlay\" name=\"cardOverlayColor\" value=\"#ffffff\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\">\n        <input type=\"image\" title=\"Background Image\" value=\"../_images/background4.jpg\">\n        <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type!='color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"bg.type!='color' && overlay\">\n    <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"bg.type!='color' && overlay\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <!--  -->\n    <div mbr-class=\"{'container': !fullWidth,\n                     'container-fluid': fullWidth}\">\n        <div class=\"mbr-row mbr-jc-c mbr-pb-5\" mbr-class=\"{'align-center': titleAlign==2,\n                         'align-right': titleAlign==3}\">\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-12 mbr-pb-4\" mbr-if=\"showTitle\">\n                <h3 class=\"mbr-fonts-style mbr-bold text-upper\" mbr-theme-style=\"display-5\">full 🖤 support&nbsp;</h3>\n            </div>\n            <div class=\"mbr-col-sm-12 mbr-col-md-12 mbr-col-lg-12\" mbr-if=\"showSubtitle\">\n                <p class=\"mbr-fonts-style custom-section-subtitle\" mbr-theme-style=\"display-7\" data-app-selector=\".custom-section-subtitle\">Browse the collection of projects, initiatives, and strategic networks supported.</p>\n            </div>\n        </div>\n        <div class=\"mbr-row mbr-jc-c\">\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.20.01-506x277.jpg\" layout=\"responsive\" width=\"303.4922238267148\" height=\"166.141\" alt=\"image\" title=\"End Pandemics\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://endpandemics.earth\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.20.01-506x277.jpg\" class=\"mbr-temp\" alt title=\"End Pandemics\"></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">End <br>PANDEMICS</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Biodiversity Protection)<br>Technical-Co Founder &amp; Coordinator<br><br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 1\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.21.23-506x279.jpg\" layout=\"responsive\" width=\"303.4984372759857\" height=\"167.344\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://acet-recovery.com\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.21.23-506x279.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">ACET <br>RECOVERY</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Illicit Trafficking)<br>Technical Executive</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 2\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.21.55-506x280.jpg\" layout=\"responsive\" width=\"303.4879571428571\" height=\"167.938\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://planetpositive.ventures\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.21.55-506x280.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">PLANET <br>POSITIVE</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Venture capital advisory)<br>Operating Partner (2020)</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 3\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.20.26-506x281.jpg\" layout=\"responsive\" width=\"303.4757508896797\" height=\"168.531\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://regen.network\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.20.26-506x281.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">REGEN <br>NETWORK</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Ecological DeFi)<br>Head of Design&nbsp;<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 4\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.23.00-506x280.jpg\" layout=\"responsive\" width=\"303.4879571428571\" height=\"167.938\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://genblue.gitlab.io/living-systems-economy\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.23.00-506x280.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">LIVING SYSTEMS ECONOMY</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Central Bank Carbon Currency)<br>Design Hero<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 5\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.24.24-506x279.jpg\" layout=\"responsive\" width=\"303.4984372759857\" height=\"167.344\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://generation.blue\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.24.24-506x279.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">GENERATION <br>BLUE</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Regenerative Economy)<br>Co-Founder<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 6\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.20.13-506x279.jpg\" layout=\"responsive\" width=\"303.4984372759857\" height=\"167.344\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://earthpulse.io\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.20.13-506x279.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">EARTH <br>PULSE</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Monitoring, Evaluation, &amp; Rewards)<br>&nbsp;Technical Coordinator<br></p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"custom-card mbr-col-sm-12 mbr-col-md-6 mbr-col-lg-3\" mbr-if=\"cardsAmout > 7\">\n                <div class=\"card-box\">\n                    <amp-img class=\"mobirise-loader\" src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.25.46-506x279.jpg\" layout=\"responsive\" width=\"303.4984372759857\" height=\"167.344\" alt=\"image\">\n                        <div placeholder class=\"placeholder\"></div>\n                        <a href=\"https://globalmangrove.org\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/screen-shot-2020-08-10-at-23.25.46-506x279.jpg\" class=\"mbr-temp\" alt title></a>\n                    </amp-img>\n                    <div class=\"overlay\">\n                        <p class=\"mbr-fonts-style mbr-bold text-upper person-name\" mbr-theme-style=\"display-5\" data-app-selector=\".person-name\">GLOBAL MANGROVE TRUST</p>\n                        <p class=\"mbr-fonts-style mbr-bold person-info\" mbr-theme-style=\"display-7\" data-app-selector=\".person-info\">(Coastal Blue Carbon)<br>CTO<br><br></p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
